# Relaxed CSP for the /admin CMS only (Decap needs GitHub + inline/eval + blob workers).
# The rest of the site keeps its strict CSP.
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.github.com https://*.githubusercontent.com https://github.com; frame-src 'self' https://github.com;"
</IfModule>

# Do not cache the admin shell
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
